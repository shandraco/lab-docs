{
  "name": "lab-docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && E2E_SKIP_BUILD=1 pnpm test:e2e",
    "screenshots": "SCREENSHOTS=1 E2E_SKIP_BUILD=1 playwright test screenshots",
    "db:migrate": "node --env-file=.env.local scripts/migrate.ts",
    "db:auth-schema": "tsx --env-file=.env.local scripts/auth-schema.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "person:add": "tsx --env-file=.env.local scripts/add-person.ts"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.5",
    "docx": "9.8.1",
    "next": "16.3.8",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}

# Copy to .env.local for local work. Never commit real values; set them in Vercel instead.
# Validated at startup by lib/env.ts.

SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Local Postgres 17 (Brain: postgres-17-local). Production: Neon pooled connection string.
DATABASE_URL=postgres://YOUR_USER@localhost:5433/lab_docs_dev

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Sign-in code emails. Leave empty locally: codes are printed in the dev server log.
RESEND_API_KEY=
MAIL_FROM=
